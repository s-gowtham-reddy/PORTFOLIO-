{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "installCommand": "pnpm install --frozen-lockfile",
    "buildCommand": "pnpm --filter @workspace/gowtham-portfolio build",
    "outputDirectory": "artifacts/gowtham-portfolio/dist/public",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}