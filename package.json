{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @workspace/gowtham-portfolio dev",
    "dev:portfolio": "pnpm --filter @workspace/gowtham-portfolio dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:portfolio": "pnpm --filter @workspace/gowtham-portfolio run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
